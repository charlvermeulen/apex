{
  "name": "@numera/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "migrate": "node --env-file=.env scripts/migrate.mjs",
    "seed": "tsx --env-file=.env scripts/seed.mjs",
    "reset-demo": "node --env-file=.env scripts/reset-demo.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@numera/shared": "*",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
